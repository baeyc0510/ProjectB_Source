@startuml

title Blasphemous Clone - Use Case Diagram (2 Week MVP)

left to right direction

' ========================================
' Actors
' ========================================
actor Player
actor EnemyAI
actor GameSystem

' ========================================
' Player Actions
' ========================================
rectangle "Player Actions" {
    usecase "Move" as UC_Move
    usecase "Jump" as UC_Jump
    usecase "Slide Dodge" as UC_Slide
    usecase "Basic Attack" as UC_Attack
    usecase "Combo Attack" as UC_Combo
    usecase "Air Attack" as UC_AirAttack
    usecase "Down Thrust" as UC_DownAttack
    usecase "Parry" as UC_Parry
    usecase "Counter Attack" as UC_Counter
    usecase "Execution" as UC_Execute
    usecase "Use Bile Flask" as UC_Heal
    usecase "Use Prie Dieu" as UC_Checkpoint
    usecase "Pause Game" as UC_Pause
}

' ========================================
' Combat System
' ========================================
rectangle "Combat System" {
    usecase "Calculate Damage" as UC_CalcDamage
    usecase "Take Hit" as UC_TakeHit
    usecase "Apply Knockback" as UC_Knockback
    usecase "Apply Invincibility" as UC_Invincible
    usecase "Air Impulse" as UC_AirImpulse
    usecase "Hit Stop Effect" as UC_HitStop
}

' ========================================
' Enemy Actions
' ========================================
rectangle "Enemy Actions" {
    usecase "Patrol" as UC_Patrol
    usecase "Detect Player" as UC_Detect
    usecase "Chase Player" as UC_Chase
    usecase "Enemy Attack" as UC_EnemyAttack
    usecase "Stun State" as UC_Stun
    usecase "Enemy Death" as UC_EnemyDeath
    usecase "Drop Tears" as UC_DropTears
}

' ========================================
' Game System
' ========================================
rectangle "Game System" {
    usecase "Start Game" as UC_StartGame
    usecase "Game Loop" as UC_GameLoop
    usecase "Save Game" as UC_Save
    usecase "Load Game" as UC_Load
    usecase "Player Death" as UC_PlayerDeath
    usecase "Respawn" as UC_Respawn
    usecase "Apply Guilt" as UC_Guilt
    usecase "Room Transition" as UC_RoomTransition
}

' ========================================
' UI / Rendering
' ========================================
rectangle "UI / Rendering" {
    usecase "Display HUD" as UC_HUD
    usecase "Update HP Bar" as UC_HPBar
    usecase "Update Fervor Bar" as UC_FervorBar
    usecase "Update Tears Counter" as UC_TearsUI
    usecase "Show Damage Numbers" as UC_DamageNumber
    usecase "Screen Shake" as UC_ScreenShake
    usecase "Show Menu" as UC_Menu
}

' ========================================
' Player Connections
' ========================================
Player --> UC_Move
Player --> UC_Jump
Player --> UC_Slide
Player --> UC_Attack
Player --> UC_Parry
Player --> UC_Heal
Player --> UC_Checkpoint
Player --> UC_Pause

' ========================================
' Enemy AI Connections
' ========================================
EnemyAI --> UC_Patrol
EnemyAI --> UC_Detect
EnemyAI --> UC_Chase
EnemyAI --> UC_EnemyAttack

' ========================================
' System Connections
' ========================================
GameSystem --> UC_GameLoop
GameSystem --> UC_StartGame
GameSystem --> UC_HUD

' ========================================
' Include Relations
' ========================================
UC_Attack ..> UC_Combo : <<include>>
UC_Attack ..> UC_CalcDamage : <<include>>
UC_Combo ..> UC_HitStop : <<include>>

UC_Jump ..> UC_AirAttack : <<extend>>
UC_AirAttack ..> UC_DownAttack : <<extend>>
UC_AirAttack ..> UC_AirImpulse : <<extend>>

UC_Parry ..> UC_Counter : <<extend>>
UC_Counter ..> UC_CalcDamage : <<include>>

UC_TakeHit ..> UC_CalcDamage : <<include>>
UC_TakeHit ..> UC_Knockback : <<include>>
UC_TakeHit ..> UC_Invincible : <<include>>
UC_TakeHit ..> UC_ScreenShake : <<include>>

UC_Stun ..> UC_Execute : <<extend>>
UC_Execute ..> UC_EnemyDeath : <<include>>

UC_EnemyDeath ..> UC_DropTears : <<include>>
UC_DropTears ..> UC_TearsUI : <<include>>

UC_Detect ..> UC_Chase : <<include>>
UC_Chase ..> UC_EnemyAttack : <<extend>>

UC_Checkpoint ..> UC_Save : <<include>>

UC_PlayerDeath ..> UC_Guilt : <<include>>
UC_PlayerDeath ..> UC_Respawn : <<include>>
UC_Respawn ..> UC_Load : <<include>>

UC_GameLoop ..> UC_HUD : <<include>>
UC_HUD ..> UC_HPBar : <<include>>
UC_HUD ..> UC_FervorBar : <<include>>
UC_HUD ..> UC_TearsUI : <<include>>

UC_Pause ..> UC_Menu : <<include>>

UC_Move ..> UC_RoomTransition : <<extend>>

' ========================================
' Cross-package Interactions
' ========================================
UC_Attack ..> UC_TakeHit : enemy hit
UC_EnemyAttack ..> UC_TakeHit : player hit
UC_Parry ..> UC_Stun : on success

' ========================================
' Notes
' ========================================
note right of UC_Combo
  3-hit combo system
  Attack1 -> Attack2 -> Attack3
  Requires timing window input
end note

note right of UC_Execute
  Execution conditions:
  - Enemy HP below 20%
  - After successful parry
end note

note bottom of UC_Slide
  Invincibility frames:
  0.05s ~ 0.25s
end note

note right of UC_Guilt
  On death:
  - Max Fervor reduced
  - Guilt fragment created
end note

@enduml
